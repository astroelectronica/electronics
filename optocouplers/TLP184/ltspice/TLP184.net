*LTspice
*
*TLP184
*AC Input-Transistor Output Optocoupler, 1-Element, 3750V Iso.
*AE01009184
*
*netlist
.include TLP184.cir
*
*params
.param RK=210
.param RC=500
*
.param VSOURCE=5
.param freq=500
.param voff=0
.param vampl=5
.param delay=0
.param repeat=4
*
.param cycle=1/freq
.param x_base=(cycle*repeat)+delay
*
*transient response
.tran 0 {x_base} 0 ;uic startup
*

